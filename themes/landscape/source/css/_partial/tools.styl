.tools-body
  background: #f3f6fa

  .outer.no-sidebar
    box-sizing: border-box
    max-width: 1380px
    padding-left: 24px
    padding-right: 24px

  .main-full-width
    float: none
    width: 100%
    margin: 0

  .article
    overflow: visible
    border-radius: 14px
    background: transparent
    box-shadow: none

  .article-meta,
  .article-header,
  .article-footer
    display: none

  .article-entry
    padding: 0

.tools-shell
  display: grid
  grid-template-columns: 230px minmax(0, 1fr)
  align-items: start
  gap: 22px
  min-height: 590px

.tools-nav
  position: sticky
  top: 20px
  overflow: hidden
  border: 1px solid #e2e8f0
  border-radius: 14px
  background: #fff
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06)

.tools-nav-heading
  padding: 20px 20px 14px
  color: #0f172a
  font-size: 17px
  font-weight: 700
  letter-spacing: 0.02em

.tools-nav-list
  display: grid
  gap: 7px
  padding: 0 10px

.tools-nav-item
  display: grid
  grid-template-columns: 38px minmax(0, 1fr)
  align-items: center
  gap: 11px
  width: 100%
  padding: 11px 12px
  border: 0
  border-radius: 10px
  background: transparent
  color: #475569
  text-align: left
  cursor: pointer
  transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease

  &:hover
    background: #f1f5f9
    color: #0f172a
    transform: translateX(2px)

  &:focus-visible
    outline: 2px solid #38bdf8
    outline-offset: 2px

  &.is-active
    background: linear-gradient(135deg, #e0f2fe, #eef2ff)
    color: #0369a1

    .tools-nav-icon
      background: #fff
      box-shadow: 0 4px 12px rgba(2, 132, 199, 0.14)

  strong,
  small
    display: block

  strong
    font-size: 14px
    line-height: 1.5

  small
    overflow: hidden
    margin-top: 1px
    color: #94a3b8
    font-size: 11px
    line-height: 1.4
    text-overflow: ellipsis
    white-space: nowrap

.tools-nav-icon
  display: grid
  width: 38px
  height: 38px
  place-items: center
  border-radius: 9px
  background: #f1f5f9
  color: #0284c7
  font: 700 13px font-mono

.tools-nav-note
  margin-top: 18px
  padding: 16px 18px
  border-top: 1px solid #eef2f7
  color: #94a3b8
  font-size: 12px
  line-height: 1.65

.tools-workspace
  min-width: 0

.tool-panel
  box-sizing: border-box
  min-height: 540px
  padding: 28px
  border: 1px solid #e2e8f0
  border-radius: 14px
  background: #fff
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06)

  &[hidden]
    display: none

.tool-panel-header
  display: flex
  align-items: flex-start
  justify-content: space-between
  gap: 20px
  margin-bottom: 22px

  h2
    margin: 4px 0 7px
    color: #0f172a
    font-size: 24px
    line-height: 1.35

  p
    margin: 0
    color: #64748b
    font-size: 14px

.tool-eyebrow
  color: #0284c7
  font-size: 11px
  font-weight: 700
  letter-spacing: 0.14em

.tool-local-badge
  flex: 0 0 auto
  padding: 6px 10px
  border-radius: 999px
  background: #ecfdf5
  color: #047857
  font-size: 12px
  font-weight: 600

.tool-grid
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 18px

.tool-grid-editor
  position: relative

  &:after
    position: absolute
    top: 50%
    left: 50%
    z-index: 2
    width: 30px
    height: 30px
    margin: -15px 0 0 -15px
    border: 1px solid #dbeafe
    border-radius: 50%
    background: #fff
    color: #0284c7
    font: 16px/30px font-mono
    text-align: center
    content: '→'
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08)

.tool-field
  display: flex
  min-width: 0
  flex-direction: column
  gap: 8px

  textarea,
  input,
  select
    box-sizing: border-box
    width: 100%
    border: 1px solid #dbe3ed
    border-radius: 9px
    background: #fbfdff
    color: #1e293b
    font: 14px font-mono
    line-height: 1.65
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease

  textarea
    min-height: 460px
    padding: 14px
    resize: vertical

  input,
  select
    min-height: 46px
    padding: 9px 12px

  textarea:focus,
  input:focus,
  select:focus
    border-color: #38bdf8
    outline: 0
    background: #fff
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.14)

.json-highlight-output
  box-sizing: border-box
  min-height: 460px
  max-height: 680px
  overflow: auto
  margin: 0
  padding: 14px
  border: 1px solid #dbe3ed
  border-radius: 9px
  background: #0f172a
  color: #cbd5e1
  font: 14px/1.65 font-mono
  tab-size: 2
  white-space: pre

  &:focus
    border-color: #38bdf8
    outline: 0
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.14)

.json-key
  color: #7dd3fc

.json-string
  color: #86efac

.json-number
  color: #fbbf24

.json-boolean
  color: #c4b5fd

.json-null
  color: #fda4af
  font-style: italic

.json-placeholder
  color: #64748b

.tool-field textarea[hidden]
  display: none

.tool-field-heading
  display: flex
  align-items: center
  justify-content: space-between
  gap: 12px

  label,
  .tool-field-label
    color: #334155
    font-size: 13px
    font-weight: 700

  span
    color: #94a3b8
    font-size: 11px

.tool-panel-footer
  display: flex
  min-height: 40px
  align-items: flex-start
  justify-content: space-between
  gap: 16px
  margin-top: 16px

.tool-actions
  display: flex
  flex-wrap: wrap
  gap: 9px
  margin-top: 16px

.tool-panel-footer .tool-actions
  margin-top: 0

.tool-button
  min-height: 38px
  padding: 8px 15px
  border: 1px solid #d7e0ea
  border-radius: 8px
  background: #fff
  color: #334155
  font-weight: 600
  cursor: pointer
  transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease, transform 0.18s ease

  &:hover
    border-color: #38bdf8
    color: #0284c7
    background: #f0f9ff
    transform: translateY(-1px)

  &:focus-visible
    outline: 2px solid #38bdf8
    outline-offset: 2px

  &.primary
    border-color: #0284c7
    background: linear-gradient(135deg, #0284c7, #2563eb)
    color: #fff
    box-shadow: 0 5px 14px rgba(2, 132, 199, 0.22)

  &.subtle
    border-color: transparent
    color: #64748b

.tool-status
  min-height: 22px
  margin-top: 10px
  font-size: 13px
  line-height: 1.6

  &.success
    color: #16804a

  &.error
    color: #c0392b

.tool-panel-footer .tool-status
  margin-top: 8px
  text-align: right

.tool-grid-time
  margin-top: 8px

.time-result
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 12px
  margin-top: 22px

  div
    min-width: 0
    padding: 15px
    border: 1px solid #edf1f5
    border-radius: 9px
    background: #f8fafc

  dt
    margin-bottom: 7px
    color: #94a3b8
    font-size: 11px
    font-weight: 700
    letter-spacing: 0.04em

  dd
    overflow-wrap: anywhere
    color: #334155
    font: 13px font-mono

@media mq-tablet
  .tools-body .outer.no-sidebar
    padding-left: 14px
    padding-right: 14px

  .tools-shell
    grid-template-columns: 195px minmax(0, 1fr)
    gap: 14px

  .tool-panel
    padding: 22px

@media mq-mobile
  .tools-body .outer.no-sidebar
    padding-left: 10px
    padding-right: 10px

  .tools-shell
    grid-template-columns: 1fr
    gap: 12px

  .tools-nav
    position: static

  .tools-nav-heading
    padding: 15px 15px 10px

  .tools-nav-list
    grid-template-columns: repeat(2, minmax(0, 1fr))

  .tools-nav-item
    grid-template-columns: 32px minmax(0, 1fr)
    padding: 9px

  .tools-nav-icon
    width: 32px
    height: 32px

  .tools-nav-note
    display: none

  .tool-panel
    min-height: 0
    padding: 18px 14px

  .tool-panel-header
    margin-bottom: 18px

    h2
      font-size: 20px

  .tool-local-badge
    display: none

  .tool-grid,
  .time-result
    grid-template-columns: 1fr

  .tool-grid-editor:after
    display: none

  .tool-field textarea
    min-height: 320px

  .json-highlight-output
    min-height: 320px
    max-height: 520px

  .tool-panel-footer
    display: block

  .tool-panel-footer .tool-status
    text-align: left
